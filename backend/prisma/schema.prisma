datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String  @id
  email          String  @unique
  handle         String
  role           String  // STUDENT | FINDER | SECURITY | ADMIN
  department     String
  verifiedBadge  Boolean @default(true)
}

model Item {
  id            String  @id
  type          String  // LOST | FOUND
  title         String
  category      String  // Electronics | Wallets/Bags | Keys | Identification | Apparel | Books
  brand         String
  color         String
  imageUrl      String
  buildingId    String
  coords        String  // JSON string: {x, y, lat, lng}
  timestamp     String
  status        String  // REPORTED | LOGGED_IN_DEPOT | MATCH_SUGGESTED | CLAIM_PENDING | VERIFICATION_APPROVED | AWAITING_PICKUP | RETURNED | UNCLAIMED_ARCHIVE | AUCTION_DONATED
  lockerId      String?
  retentionDays Int     @default(30)
  expiresAt     String
  sensitive     String  // JSON string: { serialNumber, privateTraits, walletContents, finderPhone }
}

model Claim {
  id            String  @id
  itemId        String
  claimantId    String
  secretAnswer  String
  proofImageUrl String?
  status        String  // PENDING | EVIDENCE_REQUESTED | APPROVED | DENIED
  fraudFlags    String  // JSON string array
  qrToken       String?
  otpCode       String?
  otpExpiresAt  String?
  createdAt     String
}

model ChatMessage {
  id             String  @id
  itemId         String
  senderId       String
  senderRole     String
  senderHandle   String
  message        String
  timestamp      String
  scrubbedNotice Boolean @default(false)
}

model Feedback {
  id        String @id
  claimId   String
  rating    Int
  comment   String
  createdAt String
}
