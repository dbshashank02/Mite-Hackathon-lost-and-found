generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  handle        String
  role          String
  department    String?
  verifiedBadge Boolean  @default(false)
  createdAt     DateTime @default(now())
  items         Item[]   @relation("UserItems")
  claims        Claim[]
  messages      ChatMessage[]
  feedbacks     Feedback[]
}

model Item {
  id            String   @id @default(uuid())
  type          String
  title         String
  category      String
  brand         String?
  color         String?
  imageUrl      String?
  buildingId    String?
  coords        String?
  timestamp     DateTime @default(now())
  status        String
  lockerId      String?
  retentionDays Int
  expiresAt     DateTime?
  sensitive     String?
  reporterId    String?
  reporter      User?    @relation("UserItems", fields: [reporterId], references: [id])
  claims        Claim[]
  messages      ChatMessage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Claim {
  id           String   @id @default(uuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  claimantId   String
  claimant     User     @relation(fields: [claimantId], references: [id])
  secretAnswer String?
  proofImageUrl String?
  status       String
  fraudFlags   String?
  qrToken      String?
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  feedback     Feedback?
}

model ChatMessage {
  id        String   @id @default(uuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  claimId   String   @unique
  claim     Claim    @relation(fields: [claimId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  payload   String?
  createdAt DateTime @default(now())
}
